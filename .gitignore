# Data (regra geral: não versionar raw e intermediários)
############################################################
data/raw/
data/**/raw/

# Se você gerar batches no processed, ignore por padrão:
data/processed/**/dataset_batch_*.csv
data/processed/**/batch_*.csv
data/processed/**/mini_*.csv

############################################################
# Data (EXCEÇÕES: arquivos que DEVEM entrar no Git)
############################################################
